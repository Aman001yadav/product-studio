<mxfile host="app.diagrams.net" type="device"><diagram id="Architecture" name="Architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Product Studio: architecture (Next.js app + Floyo REST API)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Browser  ·  web/app/page.js (React, client)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#f4f8fd;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="320" height="600" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 screens (stepper)&lt;/b&gt;&lt;br&gt;1 Choose: Photo / Video tabs, option cards&lt;br&gt;2 Details: upload + prompt&lt;br&gt;3 Processing: polls every 4 s, Cancel&lt;br&gt;4 Result: before / after, Download,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Do more, Run again, Back one step" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Versions strip (page state)&lt;/b&gt;&lt;br&gt;{ id, file, type, label, from,&lt;br&gt;&amp;nbsp;&amp;nbsp;actionId, prompt }&lt;br&gt;click = open its workflow · × = remove&lt;br&gt;“from” links each result to its input" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="280" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Media&lt;/b&gt; component&lt;br&gt;image · video · audio player" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="280" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Talks to its own server only:&lt;/b&gt;&lt;br&gt;POST /api/upload&lt;br&gt;POST /api/run&lt;br&gt;GET /api/run/:id (poll)&lt;br&gt;POST /api/run/:id/cancel&lt;br&gt;GET /api/files/:name&lt;br&gt;&lt;br&gt;&lt;i&gt;The Floyo API key never&lt;br&gt;reaches the browser.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="280" height="190" as="geometry"/></mxCell><mxCell id="c9" value="Next.js server (Node 22)  ·  web/app/api + web/lib" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#f5faf4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="520" height="600" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;POST&lt;br&gt;/api/upload&lt;/b&gt;&lt;br&gt;save to data/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="375" y="100" width="118" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;POST&lt;br&gt;/api/run&lt;/b&gt;&lt;br&gt;create job" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="498" y="100" width="118" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;GET&lt;br&gt;/api/run/:id&lt;/b&gt;&lt;br&gt;advance job" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="621" y="100" width="118" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;POST&lt;br&gt;/api/run/:id/cancel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="744" y="100" width="118" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;GET&lt;br&gt;/api/files/:name&lt;/b&gt;&lt;br&gt;serve / download" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="375" y="175" width="118" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;lib/jobs.js&lt;/b&gt;  (in-memory Map)&lt;br&gt;a job = one click; runs its steps in order,&lt;br&gt;each step's result is the next step's input.&lt;br&gt;Overlapping polls share one check;&lt;br&gt;waits up to 8 polls for a late output file." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="545" y="260" width="317" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;lib/actions.js&lt;/b&gt;&lt;br&gt;11 options: workflow id,&lt;br&gt;input/output kind,&lt;br&gt;prompt, configure(),&lt;br&gt;prepare(), steps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="375" y="260" width="150" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;lib/workflow.js&lt;/b&gt;  (pure, tested)&lt;br&gt;prepareWorkflow: put file + prompt&lt;br&gt;&amp;nbsp;&amp;nbsp;into nodes by class_type&lt;br&gt;pickOutput: choose result file&lt;br&gt;inputOf · stepsOf" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="375" y="390" width="215" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;lib/floyo.js&lt;/b&gt;  (HTTP client)&lt;br&gt;startRun: get workflow JSON →&lt;br&gt;&amp;nbsp;&amp;nbsp;upload input → prepare → POST /runs&lt;br&gt;getRun · cancelRun&lt;br&gt;downloadResult → data/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="632" y="390" width="230" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;data/&lt;/b&gt; on disk&lt;br&gt;uploads + downloaded results" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="375" y="540" width="215" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;FLOYO_API_KEY&lt;/b&gt;&lt;br&gt;.env.local (not committed)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="162" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Started with &lt;b&gt;--use-system-ca&lt;/b&gt; so Node trusts the Windows certificate store" style="text;html=1;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="375" y="610" width="490" height="40" as="geometry"/></mxCell><mxCell id="c22" value="Floyo cloud" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#fff8f0;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="400" height="600" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Floyo REST API&lt;/b&gt;  (Bearer key, 100 req/min)&lt;br&gt;POST cdn.floyo.ai/upload → input_path&lt;br&gt;GET /workflows/:id → ComfyUI JSON&lt;br&gt;POST /runs · GET /runs/:id?expand=outputs…&lt;br&gt;POST /runs/:id/cancel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="360" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;GPU runners&lt;/b&gt; execute the ComfyUI workflow&lt;br&gt;(FloTime + partner credits)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="230" width="360" height="55" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Output files&lt;/b&gt; via presigned URLs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="305" width="360" height="45" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Workflows used&lt;/b&gt;&lt;br&gt;Photo: Remove background (Qwen 2.1)&lt;br&gt;Place in a scene (Seedream 5.5)&lt;br&gt;Edit with prompt (GPT Image 2.6 Flare)&lt;br&gt;Studio relight (Qwen Edit 2509)&lt;br&gt;Upscale to 4K (NVIDIA PiD)&lt;br&gt;Animate into a video (Kling v4.0)&lt;br&gt;Expand (Qwen 2.1 outpaint, step only)&lt;br&gt;Video: Add sound (MMAudio V2)&lt;br&gt;Edit video with prompt (Gemini Omni Flash 1.1)&lt;br&gt;Audio: Background music (ACE-Step 1.5 XL)&lt;br&gt;&lt;i&gt;Combined: Lifestyle banner = scene → expand&lt;br&gt;Polished video ad = edit video → add sound&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#ffffff;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="375" width="360" height="270" as="geometry"/></mxCell><mxCell id="c27" value="Checks (no browser, no credits)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#fafafa;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1300" height="120" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;tests/workflow.test.mjs&lt;/b&gt;  (node --test, 39 tests)&lt;br&gt;runs prepareWorkflow / pickOutput on saved real&lt;br&gt;workflow JSON + real run outputs (tests/fixtures)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="420" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;scripts/check-workflows.mjs&lt;/b&gt;&lt;br&gt;fetches every live workflow (read-only) and checks&lt;br&gt;it still has the nodes this app edits" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="500" y="715" width="380" height="70" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Docs&lt;/b&gt;: README · GLOSSARY · docs/spec.md&lt;br&gt;docs/adr/0001–0006 · this diagram" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="920" y="715" width="380" height="70" as="geometry"/></mxCell><mxCell id="c31" value="fetch /api/…" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="src / download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="create" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="advance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.45;entryY=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="startRun · getRun ·&#xa;downloadResult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c20" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.7;startArrow=block;startFill=1;" edge="1" parent="1" source="c18" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="download" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.7;dashed=1;" edge="1" parent="1" source="c25" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="Flow" name="Flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Product Studio: what happens when you use an option" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Browser (page.js)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#f4f8fd;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="330" height="1090" as="geometry"/></mxCell><mxCell id="c5" value="Next.js server (jobs.js · floyo.js · workflow.js)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#f5faf4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="55" width="420" height="1090" as="geometry"/></mxCell><mxCell id="c6" value="Floyo" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#fff8f0;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="810" y="55" width="330" height="1090" as="geometry"/></mxCell><mxCell id="c7" value="Open the app" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#333333;fontColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="135" y="90" width="160" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1 Choose&lt;/b&gt;: pick Photo or Video tab,&lt;br&gt;then an option card" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="95" y="160" width="240" height="55" as="geometry"/></mxCell><mxCell id="c9" value="Option needs&lt;br&gt;a file?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="140" y="240" width="150" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;2 Details&lt;/b&gt;: drop a photo / video&lt;br&gt;(or reuse the current version)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="95" y="350" width="240" height="55" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;POST /api/upload&lt;/b&gt;&lt;br&gt;save to data/, return { file, type }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="350" width="320" height="55" as="geometry"/></mxCell><mxCell id="c12" value="Edit the prompt (prefilled),&lt;br&gt;click “&lt;i&gt;Option&lt;/i&gt; →”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="95" y="440" width="240" height="55" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;POST /api/run&lt;/b&gt; { file, action, prompt, size }&lt;br&gt;→ createJob: steps = stepsOf(option)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="320" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;startRun(step)&lt;/b&gt;&lt;br&gt;GET workflow JSON · upload input to CDN&lt;br&gt;prepareWorkflow: file → LoadImage/LoadVideo,&lt;br&gt;prompt/size → model node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="320" height="75" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;POST /runs&lt;/b&gt;&lt;br&gt;run queued on Floyo GPUs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="230" height="75" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;3 Processing&lt;/b&gt;: every 4 s&lt;br&gt;GET /api/run/:id  (or Cancel)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="95" y="630" width="240" height="